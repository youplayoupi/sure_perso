<%= content_for :page_title, t(".page_title") %>

<%#
  The numbers, as opposed to the rules that multiply by them.

  Split from the rule library next door because they answer different
  questions and change on different clocks. A rule is a shape -- what is
  taxed, against what -- and changes when the law changes what it taxes. A
  rate is a figure, and changes every Finance Act. Someone here is correcting
  a number they have read somewhere else; someone there is describing a
  product. Putting both on one page would bury the second in the first, since
  the scale alone is five bands a year.

  Every figure the file carries is rendered, corrected or not. Only the
  difference is stored -- see Tax::RateEdit -- so a section nobody has touched
  keeps tracking the shipped file across upgrades.
%>

<% if @correction.persisted? && @correction.edited? %>
  <%# Stated at the top rather than left to be inferred from the highlighted
      boxes further down, because the consequence is the important part: these
      sections have stopped following the file, and will not pick up next
      year's figures. %>
  <div class="rounded-xl border border-secondary border-xs p-4 space-y-3">
    <p class="text-sm text-primary"><%= t(".edited_title") %></p>
    <p class="text-xs text-secondary max-w-prose">
      <%= t(".edited_body",
            sections: @correction.edited_sections.map { |s| t("settings.tax_rates.sections.#{s}") }.to_sentence) %>
    </p>
    <%= button_to t(".reset"),
                  settings_taxes_rates_path,
                  method: :delete,
                  class: "text-sm text-destructive hover:underline",
                  form: { data: { turbo_confirm: t(".reset_confirm") } } %>
  </div>
<% end %>

<%= styled_form_with url: settings_taxes_rates_path,
                     method: :patch,
                     scope: :tax_rates,
                     class: "space-y-6" do |f| %>

  <% if @correction.errors.any? %>
    <%= render "shared/form_errors", model: @correction %>
  <% end %>

  <%= settings_section title: t(".rates_title"), subtitle: t(".rates_subtitle") do %>
    <div class="@container space-y-8">
      <%= render "settings/tax_rates/dated_section",
                 section: "social_charges",
                 title: t("settings.tax_rates.sections.social_charges"),
                 hint: t(".social_charges_hint"),
                 mine: @mine,
                 shipped: @shipped %>

      <%# The headline figure is appended only when it can be worked out. It is
          the sum of this rate and social charges, so the one time it cannot be
          computed is when one of them is unreadable -- which is the error path
          of this very form, and no reason to take down the page that fixes
          it. %>
      <% headline = tax_headline_flat_tax(@mine) %>
      <%= render "settings/tax_rates/dated_section",
                 section: "flat_tax_income_component",
                 title: t("settings.tax_rates.sections.flat_tax_income_component"),
                 hint: [ t(".flat_tax_hint"),
                         (t(".flat_tax_headline", headline: headline) if headline) ].compact.join(" "),
                 mine: @mine,
                 shipped: @shipped %>
    </div>
  <% end %>

  <%= settings_section title: t(".brackets_title"), subtitle: t(".brackets_subtitle") do %>
    <div class="@container space-y-4" data-controller="tax-rows">
      <template data-tax-rows-target="template">
        <%= render "settings/tax_rates/bracket_schedule",
                   index: "IDX_PLACEHOLDER", entry: nil, shipped: nil %>
      </template>

      <ul data-tax-rows-target="list" class="space-y-4">
        <% tax_effective_dates(@mine, "income_tax_brackets").each_with_index do |date, index| %>
          <%= render "settings/tax_rates/bracket_schedule",
                     index: index,
                     entry: tax_entry(@mine, "income_tax_brackets", date),
                     shipped: tax_entry(@shipped, "income_tax_brackets", date) %>
        <% end %>
      </ul>

      <%= render DS::Button.new(
            text: t("settings.tax_rates.add_schedule"),
            icon: "plus",
            variant: "ghost",
            type: "button",
            data: { action: "tax-rows#add" }
          ) %>
    </div>
  <% end %>

  <%= settings_section title: t(".products_title"), subtitle: t(".products_subtitle") do %>
    <div class="@container space-y-3">
      <%# Keyed by product name rather than by index, because unlike the
          schedules above this is a fixed set: the file decides which products
          exist, and this page corrects two figures on each. Adding a product
          would mean adding a rule to go with it, which is the rule library's
          job. %>
      <% @shipped.product_names.each do |name| %>
        <%# Read unparsed, so that a figure someone has just mistyped can be
            shown back to them beside the error naming it. RateTable#ceiling
            converts to BigDecimal and would raise on exactly that input. %>
        <% shipped_years = tax_product_figure(@shipped, name, :maturity_years) %>
        <% shipped_ceiling = tax_product_figure(@shipped, name, :ceiling) %>
        <% years = tax_product_figure(@mine, name, :maturity_years) %>
        <% ceiling = tax_product_figure(@mine, name, :ceiling) %>

        <div class="grid gap-3 @xl:grid-cols-12 items-start rounded-lg border border-secondary border-xs p-3">
          <div class="@xl:col-span-4 min-w-0">
            <p class="text-sm text-primary truncate"><%= @shipped.product_label(name) %></p>
            <p class="text-xs text-subdued"><%= name %></p>
          </div>

          <div class="@xl:col-span-3">
            <%= text_field_tag "tax_rates[products][#{name}][maturity_years]",
                               years,
                               class: "form-field__input",
                               inputmode: "numeric",
                               aria: { label: t("settings.tax_rates.maturity_years") } %>
            <p class="text-xs text-subdued mt-1"><%= t("settings.tax_rates.maturity_years") %></p>
            <% unless tax_same_figure?(shipped_years, years) %>
              <p class="text-xs text-warning">
                <%= t("settings.tax_rates.shipped_was", value: tax_shipped_amount(shipped_years)) %>
              </p>
            <% end %>
          </div>

          <div class="@xl:col-span-5">
            <%= text_field_tag "tax_rates[products][#{name}][ceiling]",
                               tax_amount_field(ceiling),
                               class: "form-field__input",
                               inputmode: "decimal",
                               aria: { label: t("settings.tax_rates.ceiling") } %>
            <p class="text-xs text-subdued mt-1"><%= t("settings.tax_rates.ceiling") %></p>
            <% unless tax_same_figure?(shipped_ceiling, ceiling) %>
              <p class="text-xs text-warning">
                <%= t("settings.tax_rates.shipped_was", value: tax_shipped_amount(shipped_ceiling)) %>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-3">
    <%= f.submit t(".save") %>
    <%= link_to t(".cancel"), settings_taxes_path, class: "text-sm text-secondary hover:underline" %>
  </div>
<% end %>

<%= settings_section title: t(".about_title") do %>
  <div class="text-sm text-secondary space-y-3 max-w-prose">
    <p><%= t(".about_upgrades") %></p>
    <p><%= t(".about_dates") %></p>
    <p><%= t(".about_deletion") %></p>
    <p>
      <%= link_to t(".about_rules_link"), settings_taxes_rules_path, class: "text-link hover:underline" %>
    </p>
  </div>
<% end %>
