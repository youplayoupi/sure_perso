<% content_for :page_header do %>
  <header class="space-y-1 mb-6">
    <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
    <p class="text-sm lg:text-base text-secondary">
      <%= t(".subtitle", date: format_date(@valuation_date || Date.current, :long)) %>
    </p>
  </header>
<% end %>

<% if @unsupported %>
  <%= render DS::Alert.new(variant: :info) do %>
    <p class="font-medium"><%= t(".unsupported_title", country: @country) %></p>
    <p class="text-sm text-secondary mt-1"><%= t(".unsupported_body") %></p>
  <% end %>
<% else %>

  <div class="space-y-6">

    <%# ---- Headline ------------------------------------------------------ %>
    <%#
      The incomplete case leads, and the net figure is relabelled rather than
      footnoted. A net that is really an upper bound, printed in the same type
      as a net that is an answer, is the single most misleading thing this page
      could do.
    %>
    <% unless @snapshot.complete? %>
      <%= render DS::Alert.new(variant: :warning) do %>
        <p class="font-medium">
          <%= t(".incomplete_title", count: @snapshot.incomplete_count) %>
        </p>
        <p class="text-sm mt-1"><%= t(".incomplete_body") %></p>
      <% end %>
    <% end %>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <% [
           [ t(".gross"), tax_money(@snapshot.gross, @currency), nil ],
           [ t(".tax"), tax_money(@snapshot.tax, @currency), nil ],
           [ @snapshot.complete? ? t(".net") : t(".net_upper_bound"),
             tax_money(@snapshot.net, @currency), @snapshot.complete? ? nil : "text-warning" ],
           [ @snapshot.complete? ? t(".effective_rate") : t(".modelled_rate"),
             tax_percent(@snapshot.complete? ? @snapshot.effective_rate : @snapshot.modelled_effective_rate), nil ]
         ].each do |label, value, tone| %>
        <%= render DS::Card.new do %>
          <div class="p-4 space-y-1">
            <p class="text-xs uppercase tracking-wide text-secondary"><%= label %></p>
            <p class="text-xl font-medium <%= tone || "text-primary" %>"><%= value %></p>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# ---- Account by account -------------------------------------------- %>
    <%= render DS::Card.new do %>
      <div class="p-4 border-b border-secondary">
        <h2 class="font-medium text-primary"><%= t(".per_account") %></h2>
      </div>

      <% if @snapshot.results.empty? %>
        <p class="p-4 text-sm text-secondary"><%= t(".no_accounts") %></p>
      <% else %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-xs uppercase tracking-wide text-secondary">
              <tr class="border-b border-secondary">
                <th class="text-left  font-normal px-4 py-2">Account</th>
                <th class="text-left  font-normal px-4 py-2">Rule</th>
                <th class="text-right font-normal px-4 py-2"><%= t(".gross") %></th>
                <th class="text-right font-normal px-4 py-2">Base</th>
                <th class="text-right font-normal px-4 py-2"><%= t(".tax") %></th>
                <th class="text-right font-normal px-4 py-2"><%= t(".net") %></th>
                <th class="text-left  font-normal px-4 py-2"></th>
              </tr>
            </thead>
            <tbody>
              <% @snapshot.results.each do |r| %>
                <% status, tone = tax_status_pill(r) %>
                <tr class="border-b border-secondary/50 align-top">
                  <td class="px-4 py-3">
                    <p class="text-primary font-medium"><%= r.account_name %></p>
                    <p class="text-xs text-secondary">
                      <%= [ r.accountable_type, r.subtype ].compact.join(" / ") %>
                    </p>
                  </td>
                  <td class="px-4 py-3 text-secondary"><%= r.basis %></td>
                  <td class="px-4 py-3 text-right tabular-nums"><%= tax_money(r.gross, r.currency) %></td>
                  <td class="px-4 py-3 text-right tabular-nums"><%= tax_money(r.taxable_base, r.currency) %></td>
                  <td class="px-4 py-3 text-right tabular-nums"><%= tax_money(r.tax, r.currency) %></td>
                  <td class="px-4 py-3 text-right tabular-nums"><%= tax_money(r.net, r.currency) %></td>
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-2">
                      <span class="text-xs px-2 py-0.5 rounded-full <%= tone %>"><%= status %></span>
                      <% if r.account_id.present? %>
                        <%= link_to t(".declare"),
                                    edit_tax_account_profile_path(account_id: r.account_id),
                                    class: "text-xs text-link hover:underline" %>
                      <% end %>
                    </div>
                  </td>
                </tr>

                <%# Warnings sit under their own row, not in a footnote pile at
                    the bottom. A caveat three screens away from the number it
                    qualifies is a caveat nobody reads. %>
                <% if r.warnings.any? %>
                  <tr class="border-b border-secondary/50">
                    <td colspan="7" class="px-4 pb-3 -mt-1">
                      <ul class="text-xs text-secondary space-y-1 list-disc list-inside">
                        <% r.warnings.each do |w| %>
                          <li><%= w %></li>
                        <% end %>
                      </ul>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>

    <%# ---- Disagreements with Sure's own classification ------------------- %>
    <% if @audit.present? %>
      <%= render DS::Card.new do %>
        <div class="p-4 space-y-2">
          <h2 class="font-medium text-primary"><%= t(".audit") %></h2>
          <ul class="text-sm text-secondary space-y-1 list-disc list-inside">
            <% @audit.each do |name, note| %>
              <li><span class="text-primary"><%= name %></span>: <%= note %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>

    <%# ---- Coverage ------------------------------------------------------- %>
    <%= render DS::Card.new do %>
      <div class="p-4 space-y-3">
        <div>
          <h2 class="font-medium text-primary"><%= t(".coverage") %></h2>
          <p class="text-sm text-secondary mt-1"><%= t(".coverage_body") %></p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1 text-sm">
          <% @coverage.entries.each do |e| %>
            <div class="flex items-baseline justify-between gap-2 py-1 border-b border-secondary/30">
              <span class="<%= e.covered? ? "text-primary" : "text-secondary" %>">
                <%= e.label %>
                <% if e.custom? %>
                  <span class="text-xs text-secondary">(your rule)</span>
                <% end %>
              </span>
              <span class="text-xs <%= e.covered? ? "text-secondary" : "text-warning" %> text-right">
                <%= e.covered? ? e.rule_label : (e.suggested_rule_id ? "try #{e.suggested_rule_id}" : "no rule") %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ---- Assumptions ---------------------------------------------------- %>
    <%= render DS::Card.new do %>
      <div class="p-4 space-y-2">
        <h2 class="font-medium text-primary"><%= t(".assumptions") %></h2>
        <p class="text-sm text-secondary"><%= t(".assumptions_body") %></p>
        <ul class="text-sm text-secondary space-y-1 list-disc list-inside">
          <li>Everything is sold on <%= format_date(@valuation_date, :long) %>, in one tax year.</li>
          <li>
            Income going to the progressive scale is taxed
            <%= @assumptions.bareme? ? "by stacking it on #{tax_money(@assumptions.other_taxable_income, @currency)} of other income over #{@assumptions.parts.to_i} part(s)" : "at a flat #{tax_percent(@assumptions.flat_rate, precision: 0)}" %>.
          </li>
          <li>Rates are those in effect on the valuation date; see <code>config/tax/<%= @country.downcase %>.yml</code>.</li>
          <li>Liabilities are out of scope. This is what you would keep, not what you are worth.</li>
        </ul>
      </div>
    <% end %>
  </div>
<% end %>
