<% content_for :page_header do %>
  <header class="space-y-1 mb-6">
    <h1 class="text-xl lg:text-2xl font-medium text-primary">
      <%= t(".title", account: @account.name) %>
    </h1>
    <p class="text-sm text-secondary max-w-2xl"><%= t(".intro") %></p>
  </header>
<% end %>

<%= render DS::Card.new do %>
  <%= styled_form_with model: @profile,
                       url: tax_account_profile_path(account_id: @account.id),
                       method: :patch,
                       class: "p-4 space-y-5" do |f| %>

    <% if @profile.errors.any? %>
      <%= render DS::Alert.new(variant: :error) do %>
        <ul class="text-sm list-disc list-inside">
          <% @profile.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <%#
      Ordered by how often they matter, not by how the table is laid out.
      `paid_in` is first because it is the one figure that decides whether an
      account can be computed at all.
    %>
    <div class="space-y-1">
      <%# The currency is in the label rather than assumed. These figures are
          copied off a statement in the account's own currency, and the report
          converts them; leaving the label bare invites entering euros into a
          dollar account and getting a confidently wrong answer back. %>
      <%= f.number_field :paid_in, step: "0.01",
                         label: "Total paid in (#{@account.currency})" %>
      <p class="text-xs text-secondary"><%= t(".paid_in_hint") %></p>
    </div>

    <div class="space-y-1">
      <%= f.date_field :opened_on, label: "Date of first payment" %>
      <p class="text-xs text-secondary"><%= t(".opened_on_hint") %></p>
    </div>

    <div class="space-y-1">
      <%= f.select :product,
                   [ [ "Use Sure's classification", "" ] ] + product_choices,
                   { label: "Product" } %>
      <p class="text-xs text-secondary"><%= t(".product_hint") %></p>
    </div>

    <div class="space-y-1">
      <%= f.number_field :paid_in_deducted, step: "0.01",
                         label: "Of which deducted from taxable income (#{@account.currency})" %>
      <p class="text-xs text-secondary"><%= t(".deducted_hint") %></p>
    </div>

    <%= f.text_area :notes, rows: 2, label: "Notes" %>

    <div class="flex items-center gap-3">
      <%= f.submit t(".save") %>
      <%= link_to t(".cancel"), tax_report_path, class: "text-sm text-secondary hover:underline" %>
    </div>
  <% end %>
<% end %>
